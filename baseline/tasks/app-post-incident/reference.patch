+from .models import HealthResponse, Incident, IncidentCreate, Service, ServiceDetail
+from .validators import check_message, check_service_id, check_status
 
 logging.basicConfig(
     level=os.environ.get("LOG_LEVEL", "INFO"),
@@ -75,6 +75,30 @@ def api_get_service(service_id: str) -> ServiceDetail:
     )
 
 
+@app.post(
+    "/api/services/{service_id}/incidents",
+    response_model=Incident,
+    status_code=201,
+    tags=["services"],
+)
+def api_create_incident(service_id: str, body: IncidentCreate) -> Incident:
+    """Record an incident against a service and return it."""
+    try:
+        clean_id = check_service_id(service_id)
+        status = check_status(body.status)
+        message = check_message(body.message)
+    except ValueError as error:
+        logger.warning("rejected incident: %s", error)
+        raise HTTPException(status_code=400, detail=str(error)) from error
+
+    if store.get_service(clean_id) is None:
+        raise HTTPException(
+            status_code=404, detail=f"no service with id {clean_id!r}"
+        )
+
+    return Incident(**store.put_incident(clean_id, status, message))
+
+
