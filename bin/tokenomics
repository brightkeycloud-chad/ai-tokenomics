#!/usr/bin/env python3
"""Launcher for the tokenomics toolkit. Put bin/ on your PATH:

    export PATH="$(git rev-parse --show-toplevel)/bin:$PATH"
"""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "tools"))

from tokenomics.cli import main  # noqa: E402

sys.exit(main())
